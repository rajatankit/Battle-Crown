generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE MODELS
// ============================================================

model User {
  id                    Int                 @id @default(autoincrement())
  uid                   String?             @unique
  email                 String              @unique
  name                  String?
  dateOfBirth           DateTime?           // KYC/Age
  ageConfirmed          Boolean             @default(false)
  matchesPlayed         Int                 @default(0)
  level                 Int                 @default(1)
  protectionPoints      Int                 @default(5)
  claimedLevelRewards   Int[]               @default([])
  lastMatchAt           DateTime?
  createdAt             DateTime            @default(now())
  upiId                 String?
  fcmToken              String?
  lastProtectionDecayAt DateTime?
  bgmiIgn               String?
  bgmiUid               String?
  bio                   String?
  ffIgn                 String?
  ffUid                 String?
  banned                Boolean             @default(false)
  banReason             String?
  bannedAt              DateTime?

  // Relations
  matchHistories      MatchHistory[]
  entryPayments       EntryPayment[]
  tournamentRewards   TournamentReward[]
  withdrawalRequests  WithdrawalRequest[]
  grievances          Grievance[]
  walletAdjustments   WalletAdjustment[]

  @@map("User")
}

model Tournament {
  id                   Int       @id @default(autoincrement())
  firestoreId          String?   @unique
  title                String
  game                 String
  map                  String?
  mode                 String?
  entryFee             String?
  maxSlots             Int       @default(100)
  joinedCount          Int       @default(0)
  status               String    @default("upcoming") // upcoming | registration_closed | live | completed | cancelled
  createdAt            DateTime  @default(now())
  firstPrize           Float?    @default(0)
  secondPrize          Float?    @default(0)
  thirdPrize           Float?    @default(0)
  killReward           Float?    @default(5)
  roomId               String?
  roomPassword         String?
  startTime            DateTime? @db.Timestamp(6)
  reminderSent         Boolean   @default(false)
  lowJoinAlertSent     Boolean   @default(false)
  roomMissingAlerted   Boolean   @default(false)
  posterUrl            String?   @db.Text

  // Compliance fields
  scoringFormula        String?  // "1st: 20%, 2nd: 10%, 3rd: 5%, per-kill: ₹5"
  rulesVersion           String? @default("v1")
  rulesUrl                String? // Public rules page link
  verificationRequired    Boolean @default(true)
  noWageringDeclaration   Boolean @default(true)

  // Relations
  entryPayments        EntryPayment[]
  tournamentRewards    TournamentReward[]
  matchHistories       MatchHistory[]
  grievances           Grievance[]

  @@map("tournaments")
}

model MatchHistory {
  id             Int       @id @default(autoincrement())
  userId         Int
  tournamentId   Int?
  kills          Int       @default(0)
  placement      Int?
  screenshotUrl  String?
  ign            String?
  uid            String?
  game           String?
  mode           String?
  map            String?
  notes          String?
  resultStatus   String    @default("UNVERIFIED") // UNVERIFIED | ADMIN_REVIEW | VERIFIED | REJECTED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament       Tournament?       @relation(fields: [tournamentId], references: [id])
  entryPayments    EntryPayment[]
  tournamentReward TournamentReward?

  @@index([userId])
  @@index([tournamentId])
  @@index([resultStatus])
  @@map("match_histories")
}

// ============================================================
// DIRECT PAYMENT — entry fee paid straight to Cashfree per join,
// no stored wallet balance anywhere.
// ============================================================

model EntryPayment {
  id               Int           @id @default(autoincrement())
  userId           Int
  tournamentId     Int
  matchId          Int?
  amount           Float
  paymentGatewayId String?       @unique  // Cashfree cf_payment_id
  status           String        @default("PAID") // PAID | FAILED | REFUNDED
  description      String        // "Tournament Entry Fee - [Name] - [OrderId]"
  createdAt        DateTime      @default(now())

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament       Tournament    @relation(fields: [tournamentId], references: [id])
  match            MatchHistory? @relation(fields: [matchId], references: [id], onUpdate: NoAction)

  @@index([userId])
  @@index([tournamentId])
  @@map("entry_payments")
}

model TournamentReward {
  id                Int          @id @default(autoincrement())
  userId            Int
  tournamentId      Int
  matchHistoryId    Int          @unique
  amount            Float
  reason            String       // "1st Place" | "2nd Place" | "Per Kill x5"
  status            String       @default("PENDING_PAYOUT") // PENDING_PAYOUT | PAID
  verifiedByAdminId String?
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament        Tournament         @relation(fields: [tournamentId], references: [id])
  matchHistory      MatchHistory       @relation(fields: [matchHistoryId], references: [id])
  withdrawalRequest WithdrawalRequest?

  @@index([userId])
  @@index([tournamentId])
  @@map("tournament_rewards")
}

model WithdrawalRequest {
  id                 Int              @id @default(autoincrement())
  userId             Int
  tournamentRewardId Int              @unique
  amount             Float
  upiId              String
  status             String           @default("Pending") // Pending | Approved | Rejected | Paid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentReward   TournamentReward @relation(fields: [tournamentRewardId], references: [id])

  @@index([userId])
  @@map("withdrawal_requests")
}

// ============================================================
// GRIEVANCE SYSTEM (Mandatory for compliance)
// ============================================================

model Grievance {
  id            Int       @id @default(autoincrement())
  userId        Int
  tournamentId  Int?
  subject       String
  description   String
  status        String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | ESCALATED
  raisedAt      DateTime  @default(now())
  resolvedAt    DateTime?
  resolution    String?
  adminNotes    String?

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament    Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("grievances")
}

// ============================================================
// WALLET ADJUSTMENT LEDGER
//
// The platform has no stored balance field (see the comment on
// EntryPayment above) — "wallet balance" is always computed from
// EntryPayment/TournamentReward/WithdrawalRequest. This ledger
// follows the same philosophy: a manual admin adjustment is just
// another row that gets folded into that computed total, never a
// balance you overwrite directly.
// ============================================================

model WalletAdjustment {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Float    // positive = credit, negative = debit
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_adjustments")
}

// ============================================================
// CORTEX + SYSTEM (unchanged)
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  title     String
  message   String
  read      Boolean  @default(false)
  readBy    String[] @default([])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model PersonalPasskey {
  id           String   @id @default(cuid())
  ownerUid     String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerUid])
}

model PersonalPasskeyChallenge {
  ownerUid  String   @id
  challenge String
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CortexSecurity {
  id                String   @id @default(cuid())
  webauthnCredId    String?  @unique
  webauthnPublicKey String?
  webauthnCounter   Int      @default(0)
  webauthnChallenge String?
  patternHash       String?
  patternSalt       String?
  voiceProfile      String?
  voiceEnrolledAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MonitorState {
  id            Int      @id @default(1)
  lastCheckedAt DateTime @default(now())
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  route     String
  message   String
  stack     String?
  createdAt DateTime @default(now())
  alerted   Boolean  @default(false)
}

model Alert {
  id           Int      @id @default(autoincrement())
  type         String
  severity     String
  title        String
  message      String
  refId        String?
  notified     Boolean  @default(false)
  acknowledged Boolean  @default(false)
  escalations  Int      @default(0)
  createdAt    DateTime @default(now())
}

model CortexMemory {
  id        Int      @id @default(autoincrement())
  fact      String
  createdAt DateTime @default(now())
}

model TournamentDraft {
  id                    Int       @id @default(1)
  active                Boolean   @default(false)
  stage                 String    @default("collecting")
  title                 String?
  game                  String?
  mode                  String?
  entryFee              String?
  maxSlots              Int?
  startTime             DateTime?
  killReward            Float?
  firstPrize            Float?
  secondPrize           Float?
  thirdPrize            Float?
  duplicateTournamentId Int?
  updatedAt             DateTime  @updatedAt
}

model ConversationLog {
  id        Int      @id @default(autoincrement())
  userId    String
  role      String
  message   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AtlasDraft {
  id             Int      @id @default(1)
  active         Boolean  @default(false)
  stage          String   @default("idle") // idle | options | await_path | preview
  request        String?
  path           String?
  optionsJson    Json?
  selectedOption Int?
  generatedCode  String?
  updatedAt      DateTime @updatedAt
}

model CortexContext {
  id                 Int      @id @default(1)
  lastTournamentPk   Int?
  lastTournamentTitle String?
  lastFirestoreId    String?
  lastPlayerId       Int?
  lastPlayerName     String?
  updatedAt          DateTime @updatedAt
}

model DbWriteDraft {
  id           Int      @id @default(1)
  active       Boolean  @default(false)
  stage        String   @default("idle") // idle | confirm1 | confirm2
  request      String?
  generatedSql String?
  updatedAt    DateTime @updatedAt
}

model AtlasCommitLog {
  id             Int      @id @default(autoincrement())
  path           String
  commitSha      String
  previousContent String?  @db.Text
  status         String   @default("pending") // pending | success | failed | reverted
  request        String?
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
}

model NotificationDraft {
  id              Int      @id @default(1)
  active          Boolean  @default(false)
  stage           String   @default("await_room_id") // await_room_id | await_password
  tournamentTitle String?
  roomId          String?
  roomPassword    String?
  updatedAt       DateTime @updatedAt
}

// ============================================================
// GENERIC PENDING-ACTION DRAFT
//
// Reused for any sensitive multi-turn action that needs a
// confirmation step: banning a player, adjusting a wallet, or
// rescheduling a tournament. `kind` says which one, `payload`
// holds whatever fields that specific action collected so far.
// ============================================================

model PendingActionDraft {
  id        Int      @id @default(1)
  active    Boolean  @default(false)
  kind      String?  // "ban_player" | "wallet_adjust" | "reschedule_tournament"
  stage     String   @default("confirm1")
  payload   Json?
  updatedAt DateTime @updatedAt
}