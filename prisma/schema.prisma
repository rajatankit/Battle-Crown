generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                 @id @default(autoincrement())
  uid                   String?             @unique
  email                 String              @unique
  name                  String?
  dateOfBirth           DateTime?
  ageConfirmed          Boolean             @default(false)
  matchesPlayed         Int                 @default(0)
  level                 Int                 @default(1)
  protectionPoints      Int                 @default(5)
  claimedLevelRewards   Int[]               @default([])
  lastMatchAt           DateTime?
  createdAt             DateTime            @default(now())
  upiId                 String?
  fcmToken              String?
  lastProtectionDecayAt DateTime?
  bgmiIgn               String?
  bgmiUid               String?
  bio                   String?
  ffIgn                 String?
  ffUid                 String?
  banReason             String?
  banned                Boolean             @default(false)
  bannedAt              DateTime?
  aiUsageLogs           AiUsageLog[]
  crownRewards          CrownReward[]
  crownWallet           CrownWallet?
  entryPayments         EntryPayment[]
  grievances            Grievance[]
  matchHistories        MatchHistory[]
  subscriptionOrders    SubscriptionOrder[]
  tournamentRewards     TournamentReward[]
  organizedTournaments  Tournament[]        @relation("TournamentOrganizer")
  subscriptions         UserSubscription[]
  walletAdjustments     WalletAdjustment[]
  withdrawalRequests    WithdrawalRequest[]

  @@map("User")
}

model Tournament {
  id                    Int                @id @default(autoincrement())
  firestoreId           String?            @unique
  title                 String
  game                  String
  map                   String?
  mode                  String?
  entryFee              String?
  maxSlots              Int                @default(100)
  joinedCount           Int                @default(0)
  status                String             @default("upcoming")
  createdAt             DateTime           @default(now())
  firstPrize            Float?             @default(0)
  secondPrize           Float?             @default(0)
  thirdPrize            Float?             @default(0)
  killReward            Float?             @default(5)
  roomId                String?
  roomPassword          String?
  startTime             DateTime?          @db.Timestamp(6)
  reminderSent          Boolean            @default(false)
  lowJoinAlertSent      Boolean            @default(false)
  roomMissingAlerted    Boolean            @default(false)
  scoringFormula        String?
  rulesVersion          String?            @default("v1")
  rulesUrl              String?
  verificationRequired  Boolean            @default(true)
  noWageringDeclaration Boolean            @default(true)
  posterUrl             String?
  createdByUserId       Int?
  firstPrizeCrowns      Int                @default(0)
  joinRewardCrowns      Int                @default(1)
  killRewardCrowns      Int                @default(1)
  organizerType         String             @default("ADMIN")
  secondPrizeCrowns     Int                @default(0)
  thirdPrizeCrowns      Int                @default(0)
  isFeatured            Boolean            @default(false)
  isSpecial             String?            
  sponsorPrizeAmount    Float?             @default(0)
  crownRewards          CrownReward[]
  crownTransactions     CrownTransaction[]
  entryPayments         EntryPayment[]
  grievances            Grievance[]
  matchHistories        MatchHistory[]
  tournamentRewards     TournamentReward[]
  organizer             User?              @relation("TournamentOrganizer", fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
  @@map("tournaments")
}

model MatchHistory {
  id               Int               @id @default(autoincrement())
  userId           Int
  tournamentId     Int?
  kills            Int               @default(0)
  placement        Int?
  screenshotUrl    String?
  ign              String?
  uid              String?
  game             String?
  mode             String?
  map              String?
  notes            String?
  resultStatus     String            @default("UNVERIFIED")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  crownRewards     CrownReward[]
  entryPayments    EntryPayment[]
  tournament       Tournament?       @relation(fields: [tournamentId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentReward TournamentReward?
  @@unique([userId, tournamentId])
  @@index([userId])
  @@index([tournamentId])
  @@index([resultStatus])
  @@map("match_histories")
}

model EntryPayment {
  id               Int           @id @default(autoincrement())
  userId           Int
  tournamentId     Int
  matchId          Int?
  amount           Float
  paymentGatewayId String?       @unique
  status           String        @default("PAID")
  description      String
  createdAt        DateTime      @default(now())
  match            MatchHistory? @relation(fields: [matchId], references: [id], onUpdate: NoAction)
  tournament       Tournament    @relation(fields: [tournamentId], references: [id])
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tournamentId])
  @@map("entry_payments")
}

model TournamentReward {
  id                Int                @id @default(autoincrement())
  userId            Int
  tournamentId      Int
  matchHistoryId    Int                @unique
  amount            Float
  reason            String
  status            String             @default("PENDING_PAYOUT")
  verifiedByAdminId String?
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  matchHistory      MatchHistory       @relation(fields: [matchHistoryId], references: [id])
  tournament        Tournament         @relation(fields: [tournamentId], references: [id])
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawalRequest WithdrawalRequest?

  @@index([userId])
  @@index([tournamentId])
  @@map("tournament_rewards")
}

model WithdrawalRequest {
  id                 Int              @id @default(autoincrement())
  userId             Int
  tournamentRewardId Int              @unique
  amount             Float
  upiId              String
  status             String           @default("Pending")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tournamentReward   TournamentReward @relation(fields: [tournamentRewardId], references: [id])
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("withdrawal_requests")
}

model CrownWallet {
  id           Int                @id @default(autoincrement())
  userId       Int                @unique
  balance      Int                @default(0)
  updatedAt    DateTime           @updatedAt
  transactions CrownTransaction[]
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crown_wallets")
}

model CrownTransaction {
  id           Int         @id @default(autoincrement())
  walletId     Int
  amount       Int
  type         String
  reason       String?
  tournamentId Int?
  createdAt    DateTime    @default(now())
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  wallet       CrownWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("crown_transactions")
}

model CrownReward {
  id             Int           @id @default(autoincrement())
  userId         Int
  tournamentId   Int
  matchHistoryId Int?
  amount         Int
  reason         String
  createdAt      DateTime      @default(now())
  matchHistory   MatchHistory? @relation(fields: [matchHistoryId], references: [id])
  tournament     Tournament    @relation(fields: [tournamentId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tournamentId])
  @@map("crown_rewards")
}

model SubscriptionPlan {
  id                     Int                 @id @default(autoincrement())
  name                   String              @unique
  priceMonthlyPaisa      Int
  priceAnnualPaisa       Int
  monthlyTournamentLimit Int
  dailyAiQueryLimit      Int
  crownOrganizeCost      Int?
  featuresJson           Json
  active                 Boolean             @default(true)
  createdAt              DateTime            @default(now())
  subscriptionOrders     SubscriptionOrder[]
  subscriptions          UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id           Int              @id @default(autoincrement())
  userId       Int
  planId       Int
  status       String           @default("active")
  billingCycle String
  startsAt     DateTime
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_subscriptions")
}

model SubscriptionOrder {
  id           Int              @id @default(autoincrement())
  userId       Int
  planId       Int
  billingCycle String
  amountPaisa  Int
  cfOrderId    String           @unique
  cfPaymentId  String?          @unique
  status       String           @default("PENDING")
  createdAt    DateTime         @default(now())
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscription_orders")
}

model AiUsageLog {
  id     Int      @id @default(autoincrement())
  userId Int
  date   DateTime @db.Date
  count  Int      @default(0)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("ai_usage_logs")
}

model Grievance {
  id           Int         @id @default(autoincrement())
  userId       Int
  tournamentId Int?
  subject      String
  description  String
  status       String      @default("OPEN")
  raisedAt     DateTime    @default(now())
  resolvedAt   DateTime?
  resolution   String?
  adminNotes   String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("grievances")
}

model WalletAdjustment {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Float
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_adjustments")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  title     String
  message   String
  read      Boolean  @default(false)
  readBy    String[] @default([])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model PersonalPasskey {
  id           String   @id @default(cuid())
  ownerUid     String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerUid])
}

model PersonalPasskeyChallenge {
  ownerUid  String   @id
  challenge String
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CortexSecurity {
  id                String    @id @default(cuid())
  webauthnCredId    String?   @unique
  webauthnPublicKey String?
  webauthnCounter   Int       @default(0)
  webauthnChallenge String?
  patternHash       String?
  patternSalt       String?
  voiceProfile      String?
  voiceEnrolledAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MonitorState {
  id            Int      @id @default(1)
  lastCheckedAt DateTime @default(now())
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  route     String
  message   String
  stack     String?
  createdAt DateTime @default(now())
  alerted   Boolean  @default(false)
}

model Alert {
  id           Int      @id @default(autoincrement())
  type         String
  severity     String
  title        String
  message      String
  refId        String?
  notified     Boolean  @default(false)
  acknowledged Boolean  @default(false)
  escalations  Int      @default(0)
  createdAt    DateTime @default(now())
}

model CortexMemory {
  id        Int      @id @default(autoincrement())
  fact      String
  createdAt DateTime @default(now())
}

model TournamentDraft {
  id                    Int       @id @default(1)
  active                Boolean   @default(false)
  stage                 String    @default("collecting")
  title                 String?
  game                  String?
  mode                  String?
  entryFee              String?
  maxSlots              Int?
  startTime             DateTime?
  killReward            Float?
  firstPrize            Float?
  secondPrize           Float?
  thirdPrize            Float?
  duplicateTournamentId Int?
  updatedAt             DateTime  @updatedAt
}

model ConversationLog {
  id        Int      @id @default(autoincrement())
  userId    String
  role      String
  message   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AtlasDraft {
  id             Int      @id @default(1)
  active         Boolean  @default(false)
  stage          String   @default("idle")
  request        String?
  path           String?
  optionsJson    Json?
  selectedOption Int?
  generatedCode  String?
  updatedAt      DateTime @updatedAt
}

model DbWriteDraft {
  id           Int      @id @default(1)
  active       Boolean  @default(false)
  stage        String   @default("idle")
  request      String?
  generatedSql String?
  updatedAt    DateTime @updatedAt
}

model AtlasCommitLog {
  id              Int       @id @default(autoincrement())
  path            String
  commitSha       String
  previousContent String?
  status          String    @default("pending")
  request         String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
}

model NotificationDraft {
  id              Int      @id @default(1)
  active          Boolean  @default(false)
  stage           String   @default("await_room_id")
  tournamentTitle String?
  roomId          String?
  roomPassword    String?
  updatedAt       DateTime @updatedAt
}

model PendingActionDraft {
  id        Int      @id @default(1)
  active    Boolean  @default(false)
  kind      String?
  stage     String   @default("confirm1")
  payload   Json?
  updatedAt DateTime @updatedAt
}

model CortexContext {
  id                  Int      @id @default(1)
  lastTournamentPk    Int?
  lastTournamentTitle String?
  lastFirestoreId     String?
  lastPlayerId        Int?
  lastPlayerName      String?
  updatedAt           DateTime @updatedAt
  lastListJson        Json?
}
