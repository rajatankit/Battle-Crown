generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE MODELS
// ============================================================

model User {
  id                    Int                 @id @default(autoincrement())
  uid                   String?             @unique
  email                 String              @unique
  name                  String?
  dateOfBirth           DateTime?           // KYC/Age
  ageConfirmed          Boolean             @default(false)
  matchesPlayed         Int                 @default(0)
  level                 Int                 @default(1)
  protectionPoints      Int                 @default(5)
  claimedLevelRewards   Int[]               @default([])
  lastMatchAt           DateTime?
  createdAt             DateTime            @default(now())
  upiId                 String?
  fcmToken              String?
  lastProtectionDecayAt DateTime?
  bgmiIgn               String?
  bgmiUid               String?
  bio                   String?
  ffIgn                 String?
  ffUid                 String?
  banned                Boolean             @default(false)
  banReason             String?
  bannedAt              DateTime?

  // Relations
  matchHistories       MatchHistory[]
  entryPayments        EntryPayment[]
  tournamentRewards    TournamentReward[]
  withdrawalRequests   WithdrawalRequest[]
  grievances           Grievance[]
  walletAdjustments    WalletAdjustment[]
  crownWallet          CrownWallet?
  crownRewards         CrownReward[]
  organizedTournaments Tournament[]        @relation("TournamentOrganizer")
  subscriptions        UserSubscription[]
  subscriptionOrders   SubscriptionOrder[]
  aiUsageLogs          AiUsageLog[]

  @@map("User")
}

model Tournament {
  id                   Int       @id @default(autoincrement())
  firestoreId          String?   @unique
  title                String
  game                 String
  map                  String?
  mode                 String?
  entryFee             String?
  maxSlots             Int       @default(100)
  joinedCount          Int       @default(0)
  status               String    @default("upcoming") // upcoming | registration_closed | live | completed | cancelled
  createdAt            DateTime  @default(now())
  isFeatured           Boolean   @default(false)
  isSpecial            Boolean   @default(false)
  sponsorPrizeAmount   Float?    @default(0)
  firstPrize           Float?    @default(0)
  secondPrize          Float?    @default(0)
  thirdPrize           Float?    @default(0)
  killReward           Float?    @default(5)
  roomId               String?
  roomPassword         String?
  organizerType        String    @default("ADMIN") // ADMIN | User
  createdByUserId      Int?      // set when organizerType = "User" (crown-unlocked / subscription self-organized tournament) — doubles as the "organizerId" FK
  startTime            DateTime? @db.Timestamp(6)
  reminderSent         Boolean   @default(false)
  lowJoinAlertSent     Boolean   @default(false)
  roomMissingAlerted   Boolean   @default(false)
  posterUrl            String?   @db.Text

  // Compliance fields
  scoringFormula        String?  // "1st: 20%, 2nd: 10%, 3rd: 5%, per-kill: ₹5"
  rulesVersion           String? @default("v1")
  rulesUrl                String? // Public rules page link
  verificationRequired    Boolean @default(true)
  noWageringDeclaration   Boolean @default(true)

  // ------------------------------------------------------------
  // CROWN REWARD CONFIG (new) — legacy Float prize/killReward
  // fields above are untouched and no longer used for payouts.
  // ------------------------------------------------------------
  firstPrizeCrowns  Int @default(0)
  secondPrizeCrowns Int @default(0)
  thirdPrizeCrowns  Int @default(0)
  killRewardCrowns  Int @default(1)
  joinRewardCrowns  Int @default(1)

  // Relations
  entryPayments        EntryPayment[]
  tournamentRewards    TournamentReward[]
  matchHistories       MatchHistory[]
  grievances            Grievance[]
  crownTransactions     CrownTransaction[]
  crownRewards          CrownReward[]
  organizer             User?              @relation("TournamentOrganizer", fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
  @@map("tournaments")
}

model MatchHistory {
  id             Int       @id @default(autoincrement())
  userId         Int
  tournamentId   Int?
  kills          Int       @default(0)
  placement      Int?
  screenshotUrl  String?
  ign            String?
  uid            String?
  game           String?
  mode           String?
  map            String?
  notes          String?
  resultStatus   String    @default("UNVERIFIED") // UNVERIFIED | ADMIN_REVIEW | VERIFIED | REJECTED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament       Tournament?       @relation(fields: [tournamentId], references: [id])
  entryPayments    EntryPayment[]
  tournamentReward TournamentReward?
  crownRewards     CrownReward[]

  @@index([userId])
  @@index([tournamentId])
  @@index([resultStatus])
  @@map("match_histories")
}

// ============================================================
// DIRECT PAYMENT — entry fee paid straight to Cashfree per join,
// no stored wallet balance anywhere.
//
// NOTE: as of the pivot to a no-player-payment model (revenue via
// organizer subscriptions + sponsors instead), these three models
// (EntryPayment, TournamentReward, WithdrawalRequest) are dormant —
// left in place for now in case any legacy data references them,
// but no new rows should be created by the app going forward.
// ============================================================

model EntryPayment {
  id               Int           @id @default(autoincrement())
  userId           Int
  tournamentId     Int
  matchId          Int?
  amount           Float
  paymentGatewayId String?       @unique  // Cashfree cf_payment_id
  status           String        @default("PAID") // PAID | FAILED | REFUNDED
  description      String        // "Tournament Entry Fee - [Name] - [OrderId]"
  createdAt        DateTime      @default(now())

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament       Tournament    @relation(fields: [tournamentId], references: [id])
  match            MatchHistory? @relation(fields: [matchId], references: [id], onUpdate: NoAction)

  @@index([userId])
  @@index([tournamentId])
  @@map("entry_payments")
}

model TournamentReward {
  id                Int          @id @default(autoincrement())
  userId            Int
  tournamentId      Int
  matchHistoryId    Int          @unique
  amount            Float
  reason            String       // "1st Place" | "2nd Place" | "Per Kill x5"
  status            String       @default("PENDING_PAYOUT") // PENDING_PAYOUT | PAID
  verifiedByAdminId String?
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament        Tournament         @relation(fields: [tournamentId], references: [id])
  matchHistory      MatchHistory       @relation(fields: [matchHistoryId], references: [id])
  withdrawalRequest WithdrawalRequest?

  @@index([userId])
  @@index([tournamentId])
  @@map("tournament_rewards")
}

model WithdrawalRequest {
  id                 Int              @id @default(autoincrement())
  userId             Int
  tournamentRewardId Int              @unique
  amount             Float
  upiId              String
  status             String           @default("Pending") // Pending | Approved | Rejected | Paid
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentReward   TournamentReward @relation(fields: [tournamentRewardId], references: [id])

  @@index([userId])
  @@map("withdrawal_requests")
}

// ============================================================
// CROWN CURRENCY SYSTEM
//
// Crowns are earned ONLY by playing free tournaments — there is
// no path anywhere to purchase them with real money. This keeps
// them outside the legal definition of "other stakes" (which
// only applies to credits/coins bought with money). Crowns can
// be spent to unlock self-organizing a (free) tournament.
// ============================================================

model CrownWallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CrownTransaction[]

  @@map("crown_wallets")
}

model CrownTransaction {
  id           Int      @id @default(autoincrement())
  walletId     Int
  amount       Int      // positive = earned, negative = spent
  type         String   // "earned_match" | "spent_organize_tournament" | "admin_adjustment"
  reason       String?
  tournamentId Int?
  createdAt    DateTime @default(now())

  wallet     CrownWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tournament Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([walletId])
  @@map("crown_transactions")
}

// ------------------------------------------------------------
// CrownReward — audit ledger, one row per crown credit event
// (join bonus / placement / per-kill). Separate from
// CrownTransaction (wallet ledger) so the UI can show a clean
// "why did I get these crowns" history per tournament/match.
// ------------------------------------------------------------
model CrownReward {
  id             Int      @id @default(autoincrement())
  userId         Int
  tournamentId   Int
  matchHistoryId Int?
  amount         Int
  reason         String   // "1st Place" | "2nd Place" | "3rd Place" | "Per Kill x3" | "Join Bonus"
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament    @relation(fields: [tournamentId], references: [id])
  matchHistory MatchHistory? @relation(fields: [matchHistoryId], references: [id])

  @@index([userId])
  @@index([tournamentId])
  @@map("crown_rewards")
}

// ============================================================
// SUBSCRIPTION SYSTEM
// ============================================================

model SubscriptionPlan {
  id                      Int      @id @default(autoincrement())
  name                    String   @unique // "upgrade" | "pro" | "promax"
  priceMonthlyPaisa       Int
  priceAnnualPaisa        Int
  monthlyTournamentLimit  Int      // -1 = unlimited, 0 = not allowed via subscription path
  dailyAiQueryLimit       Int      // -1 = unlimited
  crownOrganizeCost       Int?     // null = crown-organize path not allowed on this plan
  featuresJson            Json
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())

  subscriptions      UserSubscription[]
  subscriptionOrders SubscriptionOrder[]

  @@map("subscription_plans")
}

model UserSubscription {
  id            Int      @id @default(autoincrement())
  userId        Int
  planId        Int
  status        String   @default("active") // active | expired | cancelled
  billingCycle  String   // "monthly" | "annual"
  startsAt      DateTime
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("user_subscriptions")
}

// Tracks Cashfree order/payment for subscription checkout, mirroring
// EntryPayment's paymentGatewayId-unique pattern so the webhook stays
// idempotent (duplicate delivery = no-op).
model SubscriptionOrder {
  id            Int      @id @default(autoincrement())
  userId        Int
  planId        Int
  billingCycle  String   // "monthly" | "annual"
  amountPaisa   Int
  cfOrderId     String   @unique
  cfPaymentId   String?  @unique
  status        String   @default("PENDING") // PENDING | PAID | FAILED
  createdAt     DateTime @default(now())

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@map("subscription_orders")
}

model AiUsageLog {
  id     Int      @id @default(autoincrement())
  userId Int
  date   DateTime @db.Date
  count  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("ai_usage_logs")
}

// ============================================================
// GRIEVANCE SYSTEM (Mandatory for compliance)
// ============================================================

model Grievance {
  id            Int       @id @default(autoincrement())
  userId        Int
  tournamentId  Int?
  subject       String
  description   String
  status        String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | ESCALATED
  raisedAt      DateTime  @default(now())
  resolvedAt    DateTime?
  resolution    String?
  adminNotes    String?

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament    Tournament? @relation(fields: [tournamentId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("grievances")
}

// ============================================================
// WALLET ADJUSTMENT LEDGER
//
// The platform has no stored balance field (see the comment on
// EntryPayment above) — "wallet balance" is always computed from
// EntryPayment/TournamentReward/WithdrawalRequest. This ledger
// follows the same philosophy: a manual admin adjustment is just
// another row that gets folded into that computed total, never a
// balance you overwrite directly.
// ============================================================

model WalletAdjustment {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Float    // positive = credit, negative = debit
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_adjustments")
}

// ============================================================
// CORTEX + SYSTEM (unchanged)
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  title     String
  message   String
  read      Boolean  @default(false)
  readBy    String[] @default([])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model PersonalPasskey {
  id           String   @id @default(cuid())
  ownerUid     String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerUid])
}

model PersonalPasskeyChallenge {
  ownerUid  String   @id
  challenge String
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CortexSecurity {
  id                String   @id @default(cuid())
  webauthnCredId    String?  @unique
  webauthnPublicKey String?
  webauthnCounter   Int      @default(0)
  webauthnChallenge String?
  patternHash       String?
  patternSalt       String?
  voiceProfile      String?
  voiceEnrolledAt   DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MonitorState {
  id            Int      @id @default(1)
  lastCheckedAt DateTime @default(now())
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  route     String
  message   String
  stack     String?
  createdAt DateTime  @default(now())
  alerted   Boolean   @default(false)
}

model Alert {
  id           Int      @id @default(autoincrement())
  type         String
  severity     String
  title        String
  message      String
  refId        String?
  notified     Boolean  @default(false)
  acknowledged Boolean  @default(false)
  escalations  Int      @default(0)
  createdAt    DateTime @default(now())
}

model CortexMemory {
  id        Int      @id @default(autoincrement())
  fact      String
  createdAt DateTime @default(now())
}

model TournamentDraft {
  id                    Int       @id @default(1)
  active                Boolean   @default(false)
  stage                 String    @default("collecting")
  title                 String?
  game                  String?
  mode                  String?
  entryFee              String?
  maxSlots              Int?
  startTime             DateTime?
  killReward            Float?
  firstPrize            Float?
  secondPrize           Float?
  thirdPrize            Float?
  duplicateTournamentId Int?
  updatedAt             DateTime  @updatedAt
}

model ConversationLog {
  id        Int      @id @default(autoincrement())
  userId    String
  role      String
  message   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AtlasDraft {
  id             Int      @id @default(1)
  active         Boolean  @default(false)
  stage          String   @default("idle") // idle | options | await_path | preview
  request        String?
  path           String?
  optionsJson    Json?
  selectedOption Int?
  generatedCode  String?
  updatedAt      DateTime @updatedAt
}

model DbWriteDraft {
  id           Int      @id @default(1)
  active       Boolean  @default(false)
  stage        String   @default("idle") // idle | confirm1 | confirm2
  request      String?
  generatedSql String?
  updatedAt    DateTime @updatedAt
}

model AtlasCommitLog {
  id             Int      @id @default(autoincrement())
  path           String
  commitSha      String
  previousContent String?  @db.Text
  status         String   @default("pending") // pending | success | failed | reverted
  request        String?
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
}

model NotificationDraft {
  id              Int      @id @default(1)
  active          Boolean  @default(false)
  stage           String   @default("await_room_id") // await_room_id | await_password
  tournamentTitle String?
  roomId          String?
  roomPassword    String?
  updatedAt       DateTime @updatedAt
}

// ============================================================
// GENERIC PENDING-ACTION DRAFT
//
// Reused for any sensitive multi-turn action that needs a
// confirmation step: banning a player, adjusting a wallet, or
// rescheduling a tournament. `kind` says which one, `payload`
// holds whatever fields that specific action collected so far.
// ============================================================

model PendingActionDraft {
  id        Int      @id @default(1)
  active    Boolean  @default(false)
  kind      String?  // "ban_player" | "wallet_adjust" | "reschedule_tournament"
  stage     String   @default("confirm1")
  payload   Json?
  updatedAt DateTime @updatedAt
}

model CortexContext {
  id                 Int      @id @default(1)
  lastTournamentPk   Int?
  lastTournamentTitle String?
  lastFirestoreId    String?
  lastPlayerId       Int?
  lastPlayerName     String?
  lastListJson       Json?     // NEW — last shown list, for "dusra wala" references
  updatedAt          DateTime @updatedAt
}